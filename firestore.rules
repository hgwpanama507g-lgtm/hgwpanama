rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email == 'hgwpanama507g@gmail.com';
    }

    // Validation helper for ContactMessage
    function isValidContact(data) {
      return data.keys().hasAll(['fullName', 'phone', 'visitorType', 'status', 'createdAt']) &&
        data.keys().hasOnly(['fullName', 'phone', 'visitorType', 'interest', 'summary', 'messages', 'status', 'notes', 'createdAt']) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
        data.visitorType is string && data.visitorType in ['socio', 'emprendedor', 'cliente', 'informacion', 'otro'] &&
        data.status is string && data.status in ['nuevo', 'contactado', 'cerrado'] &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!data.keys().has('interest') || (data.interest is string && data.interest.size() <= 200)) &&
        (!data.keys().has('summary') || (data.summary is string && data.summary.size() <= 1000)) &&
        (!data.keys().has('notes') || (data.notes is string && data.notes.size() <= 1000));
    }

    // Contacts collection: Anonymous visitors can create (submit lead), but ONLY admin can read, update, or delete
    match /contacts/{contactId} {
      allow create: if isValidContact(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Productos collection: Public read if estado == 'publicado' or 'agotado', admin can read/write all
    match /productos/{productId} {
      allow read: if resource.data.estado in ['publicado', 'agotado'] || isAdmin();
      allow write: if isAdmin();
    }
  }
}
